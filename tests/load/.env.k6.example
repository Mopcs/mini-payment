# Client configuration for the k6 suite.
#
# Copy to tests/load/.env.k6 and fill in. That file is ignored by Git; this
# example is the only one that is tracked.
#
#   cp tests/load/.env.k6.example tests/load/.env.k6
#
# Every value below reaches k6 through __ENV. Nothing here has a production
# default: BASE_URL is required and the suite refuses to run without it.

# Target. Use the isolated load environment, never a shared or production host.
# host.docker.internal is how a container reaches the host on Docker Desktop.
# On Linux run with K6_DOCKER_NETWORK=host and use http://127.0.0.1:8080.
BASE_URL=http://host.docker.internal:8080

# Password for the dedicated load test accounts. At least 12 characters,
# because the API rejects anything shorter. Do not reuse a real credential.
LOAD_TEST_PASSWORD=

# Accounts are derived from these two values, so a rerun reuses the same users
# instead of creating new ones. Changing the password makes the existing
# accounts unusable: use a new prefix instead.
LOAD_TEST_USER_PREFIX=k6-load
LOAD_TEST_EMAIL_DOMAIN=loadtest.example

# Wallet topology. senders transfer, receivers only receive, and the hot wallet
# is the single source that the contention scenario locks concurrently.
LOAD_TEST_SENDERS=8
LOAD_TEST_RECEIVERS=4
LOAD_TEST_CONTENTION_VUS=4

# Amounts are minor units: 1000 is 10.00 USD.
LOAD_TEST_CURRENCY=USD
LOAD_TEST_INITIAL_FUNDS=100000000
LOAD_TEST_HOT_WALLET_FUNDS=1000000000
LOAD_TEST_TRANSFER_AMOUNT=1000

# Scenario sizes.
LOAD_TEST_BASELINE_VUS=3
LOAD_TEST_BASELINE_DURATION=30s
LOAD_TEST_BASELINE_PAUSE=1
LOAD_TEST_TRANSFER_VUS=10
LOAD_TEST_TRANSFER_DURATION=1m
LOAD_TEST_TRANSFER_PAUSE=0
LOAD_TEST_IDEMPOTENCY_REPEATS=5

# Stress stages: label:vus:duration, comma separated. Each entry ramps to its
# target over its duration.
LOAD_TEST_STRESS_STAGES=warmup:2:30s,low:10:1m,medium:25:2m,high:50:2m,recovery:5:1m
LOAD_TEST_STRESS_READ_SHARE=0.3
LOAD_TEST_STRESS_PAUSE=0

# Thresholds. The defaults are a regression guard, not a capacity claim; see
# the README before tightening them.
#
# THRESHOLD_P95_MS / THRESHOLD_P99_MS apply to the normal scenarios.
# THRESHOLD_CONTENTION_P95_MS is for the flow where every virtual user sends
# from one wallet: its latency is lock queueing time, so it gets its own budget.
# THRESHOLD_STRESS_P95_MS / _P99_MS are for the stress run, which deliberately
# saturates the system; error and success rates keep the normal budgets there.
THRESHOLD_HTTP_FAILED_RATE=0.01
THRESHOLD_P95_MS=300
THRESHOLD_P99_MS=800
THRESHOLD_CONTENTION_P95_MS=800
THRESHOLD_STRESS_P95_MS=2000
THRESHOLD_STRESS_P99_MS=5000
THRESHOLD_TRANSFER_SUCCESS_RATE=0.99
THRESHOLD_BUSINESS_REJECTED=0

# Where handleSummary writes the JSON report, relative to tests/load.
LOAD_TEST_RESULTS_DIR=results
