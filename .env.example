APP_ADDR=:8080
POSTGRES_DB=payment_db
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=local_dev_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# The Compose PostgreSQL container does not serve TLS, and the pool does not
# request a specific sslmode, so tell libpq to connect without TLS.
PGSSLMODE=disable
# pgxpool limits, per process. api, worker, and consumer each open their own
# pool against the same PostgreSQL, so the sum must stay below max_connections
# (100 by default). Ten each leaves room for a second instance of every process.
# Raising these is only worth it with a measurement showing callers waiting;
# see docs/performance-report.md.
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=local_dev_redis_password
RABBITMQ_USER=payment_user
RABBITMQ_PASSWORD=local_dev_rabbitmq_password
RABBITMQ_URL=amqp://payment_user:local_dev_rabbitmq_password@127.0.0.1:5672/
RABBITMQ_EXCHANGE=payment.events
RABBITMQ_QUEUE=payment.events
RABBITMQ_ROUTING_KEY=transfer.completed
RABBITMQ_RETRY_EXCHANGE=payment.events.retry
RABBITMQ_RETRY_QUEUE=payment.events.retry
RABBITMQ_DEAD_LETTER_EXCHANGE=payment.events.dlx
RABBITMQ_DEAD_LETTER_QUEUE=payment.events.dlq
RABBITMQ_DEAD_LETTER_ROUTING_KEY=transfer.completed.dlq
RABBITMQ_RETRY_DELAY=5s
CONSUMER_MAX_RETRIES=5
CONSUMER_PREFETCH_COUNT=10
CONSUMER_RECONNECT_INTERVAL=1s
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=1s
OUTBOX_LEASE_DURATION=30s
OUTBOX_MAX_BACKOFF=5m
LOG_LEVEL=info
JWT_SECRET=replace-this-placeholder-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=mini-payment-system
JWT_ACCESS_TOKEN_TTL=15m
# Metrics listeners, one port per process. Prometheus runs in Docker and
# scrapes them through the host gateway, so they must bind to an address the
# container can reach. These labels carry no identifiers (route patterns only),
# but a production host should still firewall these ports to the monitoring
# network. Use 127.0.0.1:9091-9093 instead when Prometheus runs on the host.
API_METRICS_ADDR=0.0.0.0:9091
WORKER_METRICS_ADDR=0.0.0.0:9092
CONSUMER_METRICS_ADDR=0.0.0.0:9093

# Monitoring stack (docker compose). Ports bind to 127.0.0.1 only.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-placeholder-with-a-strong-password

# Distributed tracing. Set OTEL_TRACING_ENABLED=false to run without a
# collector; the processes keep working and simply emit no spans.
OTEL_TRACING_ENABLED=true
# Leave OTEL_SERVICE_NAME unset to use the per-process default
# (mini-payment-api, mini-payment-worker, mini-payment-consumer).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Jaeger, the local trace backend. UI on 16686, OTLP ingestion on 4317.
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4317

# pprof on a separate loopback-only listener. Off by default; a wildcard or
# LAN address is rejected at startup. Turn it on only while investigating.
PROFILING_ENABLED=false
PROFILING_ADDR=127.0.0.1:6060

# Environment name. production refuses placeholder secrets.
APP_ENV=development

# HTTP server deadlines. Every value must be between 1s and 5m.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Budget for a graceful stop after SIGTERM or SIGINT. Must stay below the
# container stop grace period (30s in the production Compose file) and above the
# 15s an in-flight delivery or outbox batch is allowed to finish.
SHUTDOWN_TIMEOUT=20s

# Rate limiting. Counters live in Redis and are shared by every API instance.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_FINANCIAL_LIMIT=30
RATE_LIMIT_FINANCIAL_WINDOW=1m
# Comma separated IPs or CIDR ranges whose X-Forwarded-For is believed.
# Empty means forwarded headers are ignored entirely.
TRUSTED_PROXIES=

# CORS. Empty means CORS stays off, which is the default for an API without a
# browser client.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
