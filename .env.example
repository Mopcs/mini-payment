APP_ADDR=:8080
POSTGRES_DB=payment_db
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=local_dev_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=local_dev_redis_password
RABBITMQ_USER=payment_user
RABBITMQ_PASSWORD=local_dev_rabbitmq_password
RABBITMQ_URL=amqp://payment_user:local_dev_rabbitmq_password@127.0.0.1:5672/
RABBITMQ_EXCHANGE=payment.events
RABBITMQ_QUEUE=payment.events
RABBITMQ_ROUTING_KEY=transfer.completed
RABBITMQ_RETRY_EXCHANGE=payment.events.retry
RABBITMQ_RETRY_QUEUE=payment.events.retry
RABBITMQ_DEAD_LETTER_EXCHANGE=payment.events.dlx
RABBITMQ_DEAD_LETTER_QUEUE=payment.events.dlq
RABBITMQ_DEAD_LETTER_ROUTING_KEY=transfer.completed.dlq
RABBITMQ_RETRY_DELAY=5s
CONSUMER_MAX_RETRIES=5
CONSUMER_PREFETCH_COUNT=10
CONSUMER_RECONNECT_INTERVAL=1s
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=1s
OUTBOX_LEASE_DURATION=30s
OUTBOX_MAX_BACKOFF=5m
LOG_LEVEL=info
JWT_SECRET=replace-this-placeholder-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=mini-payment-system
JWT_ACCESS_TOKEN_TTL=15m
