          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(payment_consumer_duplicate_events_total{job=\"payment-consumer\"}[$__rate_interval]))",
          "legendFormat": "duplicates"
