      "type": "timeseries",
      "title": "Dead-lettered messages",
      "description": "Messages forwarded to the dead-letter queue: permanent errors and exhausted retries. This is the count of events that will never be processed automatically.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(payment_consumer_messages_dead_lettered_total{job=\"payment-consumer\"}[$__rate_interval]))",
          "legendFormat": "dead-lettered"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Consumer processing duration p95",
      "description": "95th percentile of message processing time, computed from payment_consumer_processing_duration_seconds_bucket.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
