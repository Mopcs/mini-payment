    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Consumer duplicate events",
      "description": "Redelivered events already recorded earlier. A steady trickle is normal after a consumer restart; a sustained rate points at ack or lease problems.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
