    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumer messages processed",
      "description": "Messages whose notification transaction committed. This is the end of the pipeline, not a duplicate of the API or outbox panels.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(payment_consumer_messages_processed_total{job=\"payment-consumer\"}[$__rate_interval]))",
          "legendFormat": "processed"
        }
