# Template for deployments/docker-compose.prod.yml.
#
#   cp deployments/.env.production.example deployments/.env.production
#   # fill in the secrets, then
#   docker compose -f deployments/docker-compose.prod.yml --env-file deployments/.env.production up -d
#
# Every secret below must be generated, not copied. The application refuses to
# start with APP_ENV=production when JWT_SECRET still looks like a placeholder.

# Database. The password is also handed to the PostgreSQL container, so it must
# not contain characters that need shell quoting.
POSTGRES_DB=payment_db
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=

# Redis holds the rate-limit counters, so an unauthenticated Redis is an
# unauthenticated rate limiter.
REDIS_PASSWORD=

# The password is interpolated into an AMQP URL, so keep it URL safe:
# letters, digits, and - _ . ~ only.
RABBITMQ_USER=payment_user
RABBITMQ_PASSWORD=

# At least 32 bytes of randomness: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=mini-payment-system

# Trace export. Point this at a collector attached to the backend network; the
# backend network has no route to the internet, so a remote collector will not
# be reachable from here.
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Stop the processes gracefully. This budget must stay below the 30s
# stop_grace_period the Compose file gives every application service.
SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=info

# The API is published on loopback only. Widen this only when a TLS-terminating
# proxy runs elsewhere.
API_PUBLISH_ADDR=127.0.0.1
API_PORT=8080

# Comma separated IPs or CIDR ranges whose X-Forwarded-For is believed. Leave
# empty unless a proxy you control sits in front of the API.
TRUSTED_PROXIES=

# Empty keeps CORS off, which is correct for a service-to-service API.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Image tag applied to all five images. Use the commit SHA in a real deployment
# so a rollback means running the previous tag.
IMAGE_TAG=latest
